---
import { Image } from 'astro:assets';

interface Slide {
	image: ImageMetadata;
	alt: string;
	caption: string;
	description?: string;
	href: string;
	linkText?: string;
}

interface Props {
	slides: Slide[];
}

const { slides } = Astro.props;
---

<div class="hc-carousel" data-carousel>
	<div class="hc-carousel-track">
		{
			slides.map((slide, i) => (
				<a
					class="hc-carousel-slide"
					class:list={{ 'is-active': i === 0 }}
					href={slide.href}
					data-index={i}
				>
					<Image src={slide.image} alt={slide.alt} width={1600} loading={i === 0 ? 'eager' : 'lazy'} class="hc-carousel-img" />
					<div class="hc-carousel-overlay">
						<h3>{slide.caption}</h3>
						{slide.description && <p>{slide.description}</p>}
						<span class="hc-carousel-cta">{slide.linkText ?? 'Learn more'} →</span>
					</div>
				</a>
			))
		}
	</div>

	<button type="button" class="hc-carousel-arrow hc-carousel-prev" aria-label="Previous slide">‹</button>
	<button type="button" class="hc-carousel-arrow hc-carousel-next" aria-label="Next slide">›</button>

	<div class="hc-carousel-dots">
		{
			slides.map((_, i) => (
				<button
					type="button"
					class="hc-carousel-dot"
					class:list={{ 'is-active': i === 0 }}
					data-dot={i}
					aria-label={`Go to slide ${i + 1}`}
				/>
			))
		}
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
		const slides = Array.from(root.querySelectorAll<HTMLElement>('.hc-carousel-slide'));
		const dots = Array.from(root.querySelectorAll<HTMLElement>('.hc-carousel-dot'));
		const prevBtn = root.querySelector<HTMLElement>('.hc-carousel-prev');
		const nextBtn = root.querySelector<HTMLElement>('.hc-carousel-next');
		if (slides.length < 2) {
			prevBtn?.remove();
			nextBtn?.remove();
			return;
		}

		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function show(index: number) {
			current = (index + slides.length) % slides.length;
			slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
			dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
		}

		function next() {
			show(current + 1);
		}

		function startAutoplay() {
			if (prefersReducedMotion) return;
			stopAutoplay();
			timer = setInterval(next, 6000);
		}

		function stopAutoplay() {
			if (timer) clearInterval(timer);
		}

		prevBtn?.addEventListener('click', (e) => {
			e.preventDefault();
			show(current - 1);
			startAutoplay();
		});
		nextBtn?.addEventListener('click', (e) => {
			e.preventDefault();
			next();
			startAutoplay();
		});
		dots.forEach((dot, i) => {
			dot.addEventListener('click', () => {
				show(i);
				startAutoplay();
			});
		});

		root.addEventListener('mouseenter', stopAutoplay);
		root.addEventListener('mouseleave', startAutoplay);

		startAutoplay();
	});
</script>

<style>
	.hc-carousel {
		position: relative;
		margin: 1.5rem 0;
		border-radius: 0.75rem;
		overflow: hidden;
		aspect-ratio: 16 / 7;
		background: var(--sl-color-gray-6);
	}

	.hc-carousel-track {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.hc-carousel-slide {
		position: absolute;
		inset: 0;
		display: block;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.5s ease;
		text-decoration: none;
		color: inherit;
	}

	.hc-carousel-slide.is-active {
		opacity: 1;
		pointer-events: auto;
	}

	.hc-carousel-slide :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hc-carousel-overlay {
		position: absolute;
		inset: auto 0 0 0;
		padding: 1.5rem 5rem 1.25rem 1.5rem;
		background: linear-gradient(0deg, hsl(216 55% 8% / 85%) 0%, hsl(216 55% 8% / 0%) 100%);
		color: #fff;
	}

	.hc-carousel-overlay h3 {
		margin: 0 0 0.25rem;
		font-size: var(--sl-text-xl);
		color: #fff;
	}

	.hc-carousel-overlay p {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-sm);
		color: hsl(0 0% 100% / 85%);
	}

	.hc-carousel-cta {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: hsl(216 90% 78%);
	}

	.hc-carousel-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 2.25rem;
		height: 2.25rem;
		border: none;
		border-radius: 999px;
		background: hsl(216 55% 8% / 45%);
		color: #fff;
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 0.15s ease;
	}

	.hc-carousel-arrow:hover {
		background: hsl(216 55% 8% / 70%);
	}

	.hc-carousel-prev {
		left: 0.75rem;
	}

	.hc-carousel-next {
		right: 0.75rem;
	}

	.hc-carousel-dots {
		position: absolute;
		bottom: 1.25rem;
		right: 1.25rem;
		display: flex;
		gap: 0.4rem;
	}

	.hc-carousel-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		border: none;
		background: hsl(0 0% 100% / 40%);
		cursor: pointer;
		padding: 0;
	}

	.hc-carousel-dot.is-active {
		background: #fff;
	}
</style>
