@article{arrigo_primary_2008,
	title = {Primary production in the {Southern} {Ocean}, 1997-2006},
	volume = {113},
	copyright = {All rights reserved},
	issn = {0148-0227},
	url = {http://doi.wiley.com/10.1029/2007JC004551},
	doi = {10.1029/2007JC004551},
	abstract = {Estimates of primary production in the Southern Ocean are difficult to obtain but are essential if we are to understand its role in the global carbon cycle. Here we present a 9-year time series of daily primary production calculated from remotely sensed ocean color, sea surface temperature, and sea ice concentration using a primary production algorithm parameterized specifically for use in Southern Ocean waters. Results suggest that total annual production in waters south of 50°S averaged 1949 ± 70.1 Tg C a−1 (where a is years) between 1998 and 2006, approximately half that of previous estimates. The large but relatively unproductive pelagic province accounted for {\textasciitilde}90\% of Southern Ocean production, while area normalized rates of production were greatest on the much smaller continental shelf (109 g C m−2 a−1). Surprisingly, production in the marginal ice zone was only slightly higher than in the pelagic province. The Ross Sea was the most productive sector of the Southern Ocean (mean = 503 Tg C a−1), followed closely by the Weddell Sea (mean = 477 Tg C a−1). Unlike the Arctic Ocean, there was no secular trend in either sea ice cover or annual primary production in the Southern Ocean during our 9-year study. Interannual variability in annual production was most closely tied to changes in sea ice cover, although changes in sea surface temperature also played a role. Only 31\% of the variation in annual production was explained by the Southern Annular Mode. Annual primary production could increase in the future as stronger winds increase nutrient upwelling.},
	number = {C08004},
	urldate = {2013-10-21},
	journal = {Journal of Geophysical Research: Oceans},
	author = {Arrigo, K R and van Dijken, G L and Bushinsky, S},
	month = aug,
	year = {2008},
	file = {PDF:/Users/smb-uh/Zotero/storage/D5VSVKZV/2008-Primary_production_in_the_Southern_Ocean_1997-2006.pdf:application/pdf},
}

@article{howard_role_2010,
	title = {The role of net community production in air-sea carbon fluxes at the {North} {Pacific} subarctic-subtropical boundary region},
	volume = {55},
	copyright = {All rights reserved},
	issn = {00243590},
	url = {http://www.aslo.org/lo/toc/vol_55/issue_6/2585.html},
	doi = {10.4319/lo.2010.55.6.2585},
	abstract = {The North Pacific subarctic-subtropical boundary region is an important{\textbackslash}nsink for atmospheric CO2, with high annual influx relative to surrounding{\textbackslash}nwaters and large seasonal variability. The location of the subarctic-subtropical{\textbackslash}ngyre boundary is relatively stable, but there is a large seasonal{\textbackslash}nmigration of the North Pacific Chlorophyll Front, between, similar{\textbackslash}nto 30 degrees N and similar to 45 degrees N. To determine the role{\textbackslash}nof biological productivity on the seasonal CO2 flux, we measured{\textbackslash}nsections of oxygen-argon gas ratios on cruises across the transition{\textbackslash}nzone in November 1997 (autumn) and September 2008 (summer). A simple{\textbackslash}nupper ocean model was used with the O-2 : Ar data to estimate the{\textbackslash}nnet community production (NCP) in the euphotic zone. On both cruises{\textbackslash}nthe NCP was highest at the chlorophyll front with average values{\textbackslash}nfrom 30 degrees N to 45 degrees N of 3.4 +/- 2.0 and 8.1 +/- 2.7{\textbackslash}nmmol C m(-2) d(-1) in autumn and summer, respectively. These values{\textbackslash}nare sufficient to make biologically induced carbon export an important{\textbackslash}ncomponent of the CO2 drawdown in this region. Processes that control{\textbackslash}nthe relatively high NCP at this boundary are not certain, but it{\textbackslash}nhas been demonstrated that horizontal convergence of nitrate plays{\textbackslash}nsome role.},
	number = {6},
	urldate = {2013-10-25},
	journal = {Limnology and Oceanography},
	author = {Howard, Evan and Emerson, Steven and Bushinsky, Seth and Stump, Charles},
	year = {2010},
	pages = {2585--2596},
	file = {PDF:/Users/smb-uh/Zotero/storage/I42IMKSF/2010-The_role_of_net_community_production_in_air-sea_carbon_fluxes_at_the_North_Pacific_subarctic-subtropical_boundary_r.pdf:application/pdf},
}

