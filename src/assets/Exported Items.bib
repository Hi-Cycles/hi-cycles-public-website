@article{jutras_mixing_2025,
	title = {Mixing {Accounts} for {More} {Than} {Half} of {Biogeochemical} {Changes} {Along} {Mode} {Water} {Ventilation} {Pathways}},
	volume = {52},
	copyright = {© 2025. The Author(s).},
	issn = {1944-8007},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1029/2024GL113789},
	doi = {10.1029/2024GL113789},
	abstract = {Mode waters are critical for ocean ventilation and carbon sequestration. Using observations, we trace their subduction pathways and biogeochemical evolution. Solving modified mixing equations that account for respiration reveals that less than 50\% of the oxygen changes along mode water ventilation pathways are due to respiration within the water mass, the rest being due to mixing with oxygen-poorer surrounding waters. Consequently, measured changes in oxygen or Apparent Oxygen Utilization overestimate respiration by a factor of up to two, as do derived biogeochemical quantities such as remineralized carbon. Measured nitrate changes either overestimate or underestimate remineralization depending on surrounding concentrations. Mean true respiration rates in mode waters range from −0.1 to −0.4 μ \{\vphantom{\}}{\textbackslash}upmu {\textbackslash}mol kg−1yr−1 \{\vphantom{\}}{\textbackslash}textkg{\textasciicircum}-1{\textbackslash}textyr{\textasciicircum}-1{\textbackslash}. Applying a fixed stoichiometric ratio to this respiration, we find that the total carbon export is highest in Southern Ocean mode waters, while carbon remineralization rates are highest in subtropical mode waters.},
	number = {7},
	urldate = {2025-04-16},
	journal = {Geophysical Research Letters},
	author = {Jutras, M. and Bushinsky, S. M. and Cerovečki, I. and Briggs, N.},
	year = {2025},
	keywords = {marine biogeochemistry, mixing, respiration, argo, apparent oxygen utilization},
	pages = {e2024GL113789},
