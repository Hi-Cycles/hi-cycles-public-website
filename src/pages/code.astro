---
import Layout from "../layouts/Layout.astro";
const title = "Code";
const html = `<p class="">In an effort to make float data more accessible, we are developing code in our group to read in global float data, remove outliers, and perform basic processing steps. Check back here over the next few months as we get this finalized and share.</p>



<p class="">We are additionally committed to sharing all processing code needed to reproduce our work. Check my <a href="https://bushinskyoceanlab.org/publications/" data-type="page" data-id="13">publications</a> list for links to code repositories for individual papers. </p>



<p class="">Group github: <a href="https://github.com/SethBushinsky">https://github.com/SethBushinsky</a></p>



<p class=""></p>`;
---

<Layout title={title}>
  <main class="content">
    <article set:html={html} />
  </main>
</Layout>
